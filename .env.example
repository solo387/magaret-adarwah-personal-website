# Public Entra application identifiers; these are not passwords or secrets.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# Optional exact localhost origin when running Vite on a non-default port.
COVERPATH_APP_ORIGIN=

# Server-only AI provider configuration. Never add VITE_ to these variables.
# Azure OpenAI example:
# https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT/chat/completions?api-version=2024-10-21
COVERPATH_AI_CHAT_COMPLETIONS_URL=
COVERPATH_AI_API_KEY=
COVERPATH_AI_MODEL=
COVERPATH_AI_API_KEY_HEADER=api-key

# Server-only Brave Search API key for automatic public company research.
# Configure in Coverpath Setup; never add a VITE_ prefix.
COVERPATH_BRAVE_SEARCH_API_KEY=
